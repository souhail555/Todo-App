# ===== Stripe Keys =====
# From: Stripe Dashboard > Developers > API keys
# Format: sk_live_ or sk_test_ followed by your key
STRIPE_SECRET_KEY=paste-your-stripe-secret-key-here

# From: Stripe Dashboard > Developers > Webhooks (after adding endpoint)
# Format: whsec_ followed by your secret
STRIPE_WEBHOOK_SECRET=paste-your-webhook-secret-here

# ===== Price IDs =====
# From: Stripe Dashboard > Products (click each product, copy the Price ID)
# Format: price_ followed by the id
PRICE_MONTHLY=paste-monthly-price-id-here
PRICE_YEARLY=paste-yearly-price-id-here

# ===== App Config =====
# Random long string for signing login tokens (generate any random text)
JWT_SECRET=change-me-to-a-long-random-string-please

# Your frontend URL (no trailing slash)
APP_URL=https://souhail555.github.io/Todo-App

# Port for local development
PORT=3000
